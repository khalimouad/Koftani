# ————— Stripe —————
# Get keys at https://dashboard.stripe.com/apikeys
# Leave empty to run the site in demo mode (orders are recorded as "test").
STRIPE_SECRET_KEY=
# Webhook signing secret for /api/webhooks/stripe (checkout.session.completed)
STRIPE_WEBHOOK_SECRET=

# ————— PayPal —————
# Get credentials at https://developer.paypal.com/dashboard/applications
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# "sandbox" (default) or "live"
PAYPAL_ENV=sandbox
# PayPal charges are made in USD (AED is not supported for settlement on all accounts)
AED_TO_USD_RATE=0.2723

# ————— Wise (bank transfer instructions shown to the customer) —————
WISE_ACCOUNT_NAME=Koftany FZ-LLC
WISE_IBAN=
WISE_BIC=
